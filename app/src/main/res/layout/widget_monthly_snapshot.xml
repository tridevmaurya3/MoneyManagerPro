<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetMonthlyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_surface_green"
            android:gravity="center"
            android:text="▥"
            android:textColor="#107C10"
            android:textSize="12sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="Monthly Snapshot"
                android:textColor="#17351F"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widgetMonthlyMonth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="August 2026"
                android:textColor="#617067"
                android:textSize="6sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/widgetMonthlyRefresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_surface_blue"
            android:gravity="center"
            android:text="↻"
            android:textColor="#0F6CBD"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widgetMonthlyMetricsRow"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_surface_green"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="5dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="INCOME" android:textColor="#446D4B" android:textSize="6sp" android:textStyle="bold" />
            <TextView android:id="@+id/widgetMonthlyIncome" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="₹0" android:textColor="#107C10" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_surface_red"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="5dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EXPENSE" android:textColor="#8C4A42" android:textSize="6sp" android:textStyle="bold" />
            <TextView android:id="@+id/widgetMonthlyExpense" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="₹0" android:textColor="#C42B1C" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widgetMonthlySavingCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_surface_blue"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="5dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SAVING" android:textColor="#315F83" android:textSize="6sp" android:textStyle="bold" />
            <TextView android:id="@+id/widgetMonthlySaving" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="₹0" android:textColor="#0F6CBD" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widgetMonthlyStatusRow"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_surface_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="7dp"
        android:paddingEnd="7dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widgetMonthlyStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="Saving is on track"
                android:textColor="#107C10"
                android:textSize="7sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widgetMonthlyCash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="Available cash ₹0"
                android:textColor="#617067"
                android:textSize="6sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/widgetMonthlyAnalytics"
            android:layout_width="56dp"
            android:layout_height="22dp"
            android:background="@drawable/widget_surface_purple"
            android:gravity="center"
            android:text="Analytics"
            android:textColor="#6B4FA3"
            android:textSize="7sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetMonthlyUpdated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="end"
        android:includeFontPadding="false"
        android:text="Updated now"
        android:textColor="#7A867E"
        android:textSize="6sp" />
</LinearLayout>
