<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="34dp"
        android:paddingEnd="20dp"
        android:paddingBottom="34dp">

        <!-- APP IDENTITY -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="66dp"
            android:layout_height="66dp"
            app:cardBackgroundColor="@color/success_surface"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/success_outline"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="M"
                android:textColor="@color/success"
                android:textSize="28sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:text="Money Manager Pro"
            android:textColor="@color/app_text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:text="Private and secure financial access"
            android:textColor="@color/app_text_secondary"
            android:textSize="12sp" />

        <!-- MAIN SECURITY CARD -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/app_surface"
            app:cardCornerRadius="25dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/app_outline_soft"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="20dp"
                android:paddingEnd="18dp"
                android:paddingBottom="20dp">

                <!-- SECURITY HEADER -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        app:cardBackgroundColor="@color/success_surface"
                        app:cardCornerRadius="17dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/success_outline"
                        app:strokeWidth="1dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="●"
                            android:textColor="@color/success"
                            android:textSize="23sp"
                            android:textStyle="bold" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="13dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="SECURE ACCESS"
                            android:textColor="@color/success"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtPinTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Unlock Money Manager"
                            android:textColor="@color/app_text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/txtPinSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Enter your 4-digit PIN to continue."
                    android:textColor="@color/app_text_secondary"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="17dp"
                    android:layout_marginBottom="17dp"
                    android:background="@color/app_divider" />

                <!-- PIN LABEL -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4-digit PIN"
                    android:textColor="@color/app_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- PIN INPUT -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputPin"
                    style="@style/Widget.MoneyManagerPro.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundColor="@color/app_surface"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/success"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPin"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:digits="0123456789"
                        android:gravity="center"
                        android:hint="Enter PIN"
                        android:imeOptions="actionNext"
                        android:inputType="numberPassword"
                        android:letterSpacing="0.30"
                        android:maxLength="4"
                        android:maxLines="1"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/app_text_primary"
                        android:textColorHint="@color/app_text_secondary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- CONFIRM PIN GROUP -->

                <LinearLayout
                    android:id="@+id/confirmPinContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Confirm 4-digit PIN"
                        android:textColor="@color/app_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputConfirmPin"
                        style="@style/Widget.MoneyManagerPro.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:boxBackgroundColor="@color/app_surface"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/success"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmPin"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:digits="0123456789"
                            android:gravity="center"
                            android:hint="Confirm PIN"
                            android:imeOptions="actionDone"
                            android:inputType="numberPassword"
                            android:letterSpacing="0.30"
                            android:maxLength="4"
                            android:maxLines="1"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="@color/app_text_primary"
                            android:textColorHint="@color/app_text_secondary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- BIOMETRIC BUTTON -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBiometricUnlock"
                    style="@style/Widget.MoneyManagerPro.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="17dp"
                    android:text="Unlock with Fingerprint or Face"
                    android:textColor="@color/success"
                    android:visibility="gone"
                    app:backgroundTint="@color/app_surface"
                    app:cornerRadius="17dp"
                    app:strokeColor="@color/success"
                    app:strokeWidth="1dp" />

                <!-- PRIMARY PIN ACTION -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPinAction"
                    style="@style/Widget.MoneyManagerPro.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="11dp"
                    android:text="Unlock with PIN"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/success"
                    app:cornerRadius="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmailUnlock"
                    style="@style/Widget.MoneyManagerPro.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:text="Unlock with Email Login"
                    android:textColor="@color/secondary"
                    android:visibility="gone"
                    app:backgroundTint="@color/app_surface"
                    app:cornerRadius="17dp"
                    app:strokeColor="@color/secondary"
                    app:strokeWidth="1dp" />

                <!-- SKIP SETUP -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSkipPinSetup"
                    style="@style/Widget.MoneyManagerPro.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="9dp"
                    android:text="Skip for Now"
                    android:textColor="@color/app_text_secondary"
                    app:backgroundTint="@color/app_surface"
                    app:cornerRadius="17dp"
                    app:strokeColor="@color/app_outline"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- PRIVACY MESSAGE -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            app:cardBackgroundColor="@color/success_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/success_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="13dp">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/success"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="Your PIN and financial records remain stored locally on this device."
                    android:textColor="@color/app_text_secondary"
                    android:textSize="10sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:text="Money Manager Pro • Secure Local Access"
            android:textColor="@color/app_text_secondary"
            android:textSize="9sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
