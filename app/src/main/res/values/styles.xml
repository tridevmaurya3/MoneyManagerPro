<?xml version="1.0" encoding="utf-8"?>

<resources>

    <!-- =========================================================
         PAGE TEXT STYLES
         ========================================================= -->

    <style
        name="TextAppearance.MoneyManagerPro.PageTitle"
        parent="TextAppearance.Material3.HeadlineMedium">

        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textSize">27sp</item>
        <item name="android:textStyle">bold</item>

    </style>


    <style
        name="TextAppearance.MoneyManagerPro.PageSubtitle"
        parent="TextAppearance.Material3.BodyMedium">

        <item name="android:textColor">@color/app_text_secondary</item>
        <item name="android:textSize">14sp</item>

    </style>


    <style
        name="TextAppearance.MoneyManagerPro.SectionTitle"
        parent="TextAppearance.Material3.TitleLarge">

        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>

    </style>


    <style
        name="TextAppearance.MoneyManagerPro.SectionSubtitle"
        parent="TextAppearance.Material3.BodySmall">

        <item name="android:textColor">@color/app_text_secondary</item>
        <item name="android:textSize">12sp</item>

    </style>


    <style
        name="TextAppearance.MoneyManagerPro.CardTitle"
        parent="TextAppearance.Material3.TitleMedium">

        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>

    </style>


    <style
        name="TextAppearance.MoneyManagerPro.CardDescription"
        parent="TextAppearance.Material3.BodyMedium">

        <item name="android:textColor">@color/app_text_secondary</item>
        <item name="android:textSize">13sp</item>

    </style>


    <style
        name="TextAppearance.MoneyManagerPro.AmountLarge"
        parent="TextAppearance.Material3.HeadlineLarge">

        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>

    </style>


    <style
        name="TextAppearance.MoneyManagerPro.AmountMedium"
        parent="TextAppearance.Material3.TitleLarge">

        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>

    </style>


    <style
        name="TextAppearance.MoneyManagerPro.Status"
        parent="TextAppearance.Material3.BodyMedium">

        <item name="android:textColor">@color/app_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>

    </style>


    <!-- =========================================================
         COMMON CARD STYLES
         ========================================================= -->

    <style
        name="Widget.MoneyManagerPro.Card"
        parent="Widget.Material3.CardView.Elevated">

        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/app_outline_soft</item>
        <item name="strokeWidth">1dp</item>

    </style>


    <style
        name="Widget.MoneyManagerPro.Card.Primary"
        parent="Widget.MoneyManagerPro.Card">

        <item name="cardBackgroundColor">@color/balance_surface</item>
        <item name="strokeColor">@color/balance_outline</item>
        <item name="cardCornerRadius">22dp</item>

    </style>


    <style
        name="Widget.MoneyManagerPro.Card.Success"
        parent="Widget.MoneyManagerPro.Card">

        <item name="cardBackgroundColor">@color/success_surface</item>
        <item name="strokeColor">@color/success_outline</item>

    </style>


    <style
        name="Widget.MoneyManagerPro.Card.Error"
        parent="Widget.MoneyManagerPro.Card">

        <item name="cardBackgroundColor">@color/error_surface</item>
        <item name="strokeColor">@color/error_outline</item>

    </style>


    <style
        name="Widget.MoneyManagerPro.Card.Info"
        parent="Widget.MoneyManagerPro.Card">

        <item name="cardBackgroundColor">@color/info_surface</item>
        <item name="strokeColor">@color/info_outline</item>

    </style>


    <style
        name="Widget.MoneyManagerPro.Card.Warning"
        parent="Widget.MoneyManagerPro.Card">

        <item name="cardBackgroundColor">@color/warning_surface</item>
        <item name="strokeColor">@color/warning_outline</item>

    </style>


    <style
        name="Widget.MoneyManagerPro.Card.Purple"
        parent="Widget.MoneyManagerPro.Card">

        <item name="cardBackgroundColor">@color/purple_surface</item>
        <item name="strokeColor">@color/purple_outline</item>

    </style>


    <!-- =========================================================
         COMMON BUTTON STYLES
         ========================================================= -->

    <style
        name="Widget.MoneyManagerPro.Button.Primary"
        parent="Widget.Material3.Button">

        <item name="android:minHeight">54dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/button_primary</item>
        <item name="cornerRadius">14dp</item>

    </style>


    <style
        name="Widget.MoneyManagerPro.Button.Secondary"
        parent="Widget.Material3.Button">

        <item name="android:minHeight">54dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_on_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/button_secondary</item>
        <item name="cornerRadius">14dp</item>

    </style>


    <style
        name="Widget.MoneyManagerPro.Button.Danger"
        parent="Widget.Material3.Button">

        <item name="android:minHeight">54dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/button_danger</item>
        <item name="cornerRadius">14dp</item>

    </style>


    <style
        name="Widget.MoneyManagerPro.Button.Outlined"
        parent="Widget.Material3.Button.OutlinedButton">

        <item name="android:minHeight">54dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/app_surface</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/info_outline</item>
        <item name="strokeWidth">1dp</item>

    </style>


    <style
        name="Widget.MoneyManagerPro.Button.SuccessOutlined"
        parent="Widget.Material3.Button.OutlinedButton">

        <item name="android:minHeight">54dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/success</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/success_surface</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/success_outline</item>
        <item name="strokeWidth">1dp</item>

    </style>


    <!-- =========================================================
         INPUT FIELD STYLE
         ========================================================= -->

    <style
        name="Widget.MoneyManagerPro.TextInputLayout"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="boxBackgroundColor">@color/app_surface</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/app_outline</item>
        <item name="hintTextColor">@color/app_text_secondary</item>

    </style>


    <!-- =========================================================
         DIALOG STYLE
         ========================================================= -->

    <style
        name="ThemeOverlay.MoneyManagerPro.AlertDialog"
        parent="ThemeOverlay.Material3.MaterialAlertDialog">

        <item name="colorPrimary">@color/primary</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/app_text_secondary</item>

    </style>


    <!-- =========================================================
         SUPPORTING STYLES
         Names without dots prevent automatic missing parent errors.
         ========================================================= -->

    <style name="MoneyManagerProDivider">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/app_divider</item>

    </style>


    <style name="MoneyManagerProScreenContainer">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">36dp</item>

    </style>

</resources>